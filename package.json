{
  "name": "sensory-shield",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop app that softens flashing content on screen. Reduces exposure to known triggers.",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "selftest": "SHIELD_SELFTEST=1 electron .",
    "clips": "sh test/make-clips.sh",
    "spike": "SHIELD_SELFTEST=1 SHIELD_SPIKE=1 electron .",
    "demo": "node test/serve.js",
    "app": "open -n -a \"$PWD/node_modules/electron/dist/Electron.app\" --args \"$PWD\"",
    "app:debug": "mkdir -p logs && open -n -a \"$PWD/node_modules/electron/dist/Electron.app\" --env SHIELD_DEBUG=1 --stdout \"$PWD/logs/debug.log\" --stderr \"$PWD/logs/debug.log\" --args \"$PWD\"",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "content:setup": "node scripts/content-setup.js",
    "content:eval-images": "node test/content/fetch-eval-images.js && electron test/content/run-page.js test/content/image-eval.html",
    "content:check-text": "electron test/content/run-page.js test/content/text-check.html && electron test/content/ocr-check.js",
    "content:bench": "electron test/content/run-page.js test/content/bench.html",
    "content:latency": "electron test/content/live-latency.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "onnxruntime-node": false,
    "protobufjs": false
  },
  "productName": "Sensory Shield",
  "build": {
    "appId": "app.sensoryshield",
    "productName": "Sensory Shield",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.md"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Guardian uses the camera to notice strong rhythmic movement. Video stays on this device."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "Xenova/mobileclip_s0/**",
          "Xenova/DeBERTa-v3-base-mnli-fever-anli/**",
          "jdp8/**",
          "nudenet/320n.onnx"
        ]
      },
      {
        "from": "vendor/ocr",
        "to": "ocr"
      }
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
